---
// The docs design's header: logo, top navigation, search, GitHub and a light/dark toggle.
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  { label: 'Getting started', href: `${base}/getting-started/about/`, section: `${base}/getting-started/` },
  { label: 'Foundations', href: `${base}/foundations/color/`, section: `${base}/foundations/` },
  { label: 'Components', href: `${base}/components/`, section: `${base}/components/` },
  { label: 'Blocks', href: `${base}/blocks/`, section: `${base}/blocks/` },
  { label: 'Patterns', href: `${base}/patterns/forms/`, section: `${base}/patterns/` },
  { label: 'Resources', href: `${base}/resources/links/`, section: `${base}/resources/` },
].map((n) => ({ ...n, current: path.startsWith(n.section) }));
---

<div class="header">
  <ht-button id="docs-menu" class="menu print:hidden" variant="quiet" size="sm">
    <span class="sr-only">Menu</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
  </ht-button>
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <nav class="top-nav" aria-label="Primary">
    {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <div class="search sl-flex print:hidden">{config.pagefind && <Search />}</div>
  <div class="right sl-flex print:hidden">
    <SocialIcons />
    <ht-button type="button" variant="quiet" size="sm" id="halftone-theme">
      <span class="sr-only" data-label>Switch theme</span>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </ht-button>
  </div>
</div>

<script>
  // On a phone the left sidebar is a drawer; this button opens it.
  document.getElementById('docs-menu')?.addEventListener('click', () => (document.getElementById('docs-sidebar') as (HTMLElement & { toggle(): void }) | null)?.toggle());

  const button = document.getElementById('halftone-theme');
  const label = () => (document.documentElement.dataset.theme === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme');
  const name = button?.querySelector('[data-label]');
  if (name) name.textContent = label();
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {
      /* private mode: the choice lasts for this page only */
    }
    if (name) name.textContent = label();
  });
</script>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      height: 100%;
    }
    .title-wrapper {
      min-width: 0;
      flex: none;
    }
    .top-nav {
      display: none;
      gap: 0.125rem;
      align-self: stretch;
    }
    /* Below this the left sidebar is the navigation; six links do not fit next to search. */
    @media (min-width: 64rem) {
      .top-nav {
        display: flex;
      }
    }
    .top-nav a {
      display: flex;
      align-items: center;
      padding: 0 0.5rem;
      white-space: nowrap;
      font-size: 0.9375rem;
      text-decoration: none;
      color: var(--ht-text-muted);
      border-bottom: 2px solid transparent;
      border-top: 2px solid transparent;
    }
    @media (min-width: 72rem) {
      .top-nav a {
        padding: 0 0.75rem;
      }
    }
    .top-nav a:hover {
      color: var(--ht-text);
    }
    .top-nav a[aria-current='page'] {
      font-weight: 600;
      color: var(--ht-text);
      border-bottom-color: var(--ht-accent);
    }
    .search {
      margin-inline-start: auto;
    }
    /* The menu button is only for the drawer, below 800px, and only on pages that have a sidebar. */
    .menu {
      display: none;
    }
    @media (max-width: 49.99rem) {
      :global([data-has-sidebar]) .menu {
        display: inline-flex;
      }
    }
    .right {
      gap: 0.5rem;
      align-items: center;
    }
    .right :global(.social-icons) {
      display: flex;
    }
    .icon-sun {
      display: none;
    }
    :global(:root[data-theme='dark']) .icon-sun {
      display: block;
    }
    :global(:root[data-theme='dark']) .icon-moon {
      display: none;
    }
  }
</style>
