---
// Copied from Starlight's PageFrame, with the site footer added at the bottom of the main column so it
// spans the full width beside the sidebar. When Starlight is upgraded, compare this with the new default.

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<ht-sidebar id="docs-sidebar" class="sidebar print:hidden" label={Astro.locals.t('sidebarNav.accessibleLabel')} mobile-breakpoint="800">
				<slot name="sidebar" />
			</ht-sidebar>
		)
	}
	<div class="main-frame">
		<slot />
		<footer class="site-footer">
			<span class="mark">halftone</span>
			<span>Lit web components. MIT licensed.</span>
			<span class="spacer"></span>
			<a href="https://github.com/mehrad-meraji/halftone">GitHub</a>
			<a href="https://github.com/mehrad-meraji/halftone/blob/main/CHANGELOG.md">Changelog</a>
			<a href="https://github.com/mehrad-meraji/halftone/blob/main/docs/decisions.md">Decisions log</a>
		</footer>
	</div>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		/* ht-sidebar is the column on desktop and a drawer below 800px, where it has display: contents. */
		.sidebar {
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			height: auto;
			--ht-sidebar-width: var(--sl-sidebar-width);
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
		}
	}
</style>
