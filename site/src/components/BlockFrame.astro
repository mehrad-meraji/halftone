---
// A live block: its bare preview page in a frame, with a phone-width toggle and a link to open it full size.
interface Props {
  name: string;
  title: string;
  height?: number;
}
const { name, title, height = 680 } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}block-preview/${name}/`;
---

<div class="block-frame not-content">
  <div class="block-bar">
    <ht-toggle-group class="block-widths" type="single" value="full" aria-label="Preview width">
      <ht-toggle-item value="full">Full</ht-toggle-item>
      <ht-toggle-item value="phone">Phone</ht-toggle-item>
    </ht-toggle-group>
    <a href={src} target="_blank" rel="noopener">Open in a new tab</a>
  </div>
  <div class="block-stage">
    <iframe title={`${title} block, live`} src={src} style={`height:${height}px`} loading="lazy"></iframe>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.block-frame').forEach((root) => {
    const frame = root.querySelector('iframe')!;
    root.querySelector('.block-widths')!.addEventListener('change', (e) => {
      frame.style.maxWidth = (e.target as HTMLElement & { value: string }).value === 'phone' ? '375px' : '';
    });
  });
</script>

<style>
  .block-frame {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ht-radius-lg);
    overflow: hidden;
    background: var(--ht-surface-muted);
  }
  .block-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: 0.875rem;
  }
  .block-bar a:focus-visible {
    outline: 2px solid var(--ht-focus);
    outline-offset: 2px;
  }
  .block-bar a {
    color: var(--ht-text);
    font-weight: 500;
  }
  .block-stage {
    display: flex;
    justify-content: center;
  }
  iframe {
    display: block;
    width: 100%;
    border: 0;
    background: var(--ht-bg);
    transition: max-width var(--ht-duration) var(--ht-ease);
  }
  .block-stage iframe[style*='max-width'] {
    border-inline: 1px solid var(--sl-color-hairline);
  }
  /* On a phone the frame is already phone width. */
  @media (max-width: 40rem) {
    .block-widths {
      display: none;
    }
  }
</style>

<style is:global>
  /* Blocks are whole page sections: give them more room than a page of text. Only pages with a frame get this. */
  :root {
    --sl-content-width: 64rem;
  }
</style>
