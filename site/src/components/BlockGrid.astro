---
// The Blocks hub: a filterable grid of cards, one per block, each with a small live preview.
import blocks from '../generated/blocks.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const categories = [...new Set(blocks.map((b) => b.category))].sort();
const counts = Object.fromEntries(categories.map((c) => [c, blocks.filter((b) => b.category === c).length]));
---

<div class="block-grid not-content">
  <div class="grid-tools">
    <label class="grid-search">
      <span class="sr-only">Search blocks</span>
      <input type="search" placeholder="Search blocks" autocomplete="off" />
    </label>
    <div class="grid-cats" role="group" aria-label="Category">
      <button type="button" data-cat="" aria-pressed="true">All <span>{blocks.length}</span></button>
      {categories.map((c) => (
        <button type="button" data-cat={c} aria-pressed="false">{c} <span>{counts[c]}</span></button>
      ))}
    </div>
  </div>
  <p class="grid-count" aria-live="polite"><span data-shown>{blocks.length}</span> of {blocks.length} blocks</p>
  <ul class="grid-cards">
    {blocks.map((b) => (
      <li data-cat={b.category} data-text={`${b.title} ${b.name} ${b.summary}`.toLowerCase()}>
        <a href={`${base}blocks/${b.name}/`}>
          <div class="thumb" aria-hidden="true">
            <iframe src={`${base}block-preview/${b.name}/`} title="" tabindex="-1" loading="lazy"></iframe>
          </div>
          <div class="meta">
            <span class="eyebrow">{b.category}</span>
            <strong>{b.title}</strong>
            <span class="sum">{b.summary}</span>
            <code>{b.name}</code>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p class="grid-empty" hidden>No block matches. Clear the search or pick All.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.block-grid').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('input')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.grid-cards li')];
    const shown = root.querySelector<HTMLElement>('[data-shown]')!;
    const empty = root.querySelector<HTMLElement>('.grid-empty')!;
    let cat = '';
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let n = 0;
      cards.forEach((li) => {
        const ok = (!cat || li.dataset.cat === cat) && (!q || li.dataset.text!.includes(q));
        li.hidden = !ok;
        if (ok) n++;
      });
      shown.textContent = String(n);
      empty.hidden = n > 0;
    };
    // Scale each 1280px-wide preview to its card.
    const fit = new ResizeObserver((entries) => {
      entries.forEach((e) => (e.target as HTMLElement).style.setProperty('--thumb-scale', String(e.contentRect.width / 1280)));
    });
    root.querySelectorAll('.thumb').forEach((t) => fit.observe(t));
    input.addEventListener('input', apply);
    root.querySelectorAll<HTMLButtonElement>('.grid-cats button').forEach((btn) => {
      btn.addEventListener('click', () => {
        cat = btn.dataset.cat ?? '';
        root.querySelectorAll('.grid-cats button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply();
      });
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .grid-tools {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .grid-search input {
    box-sizing: border-box;
    width: 100%;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--ht-border-input);
    border-radius: var(--ht-radius-md);
    background: var(--ht-surface);
    color: var(--ht-text);
    font: inherit;
    font-size: 0.9375rem;
  }
  .grid-search input:focus-visible,
  .grid-cats button:focus-visible,
  .grid-cards a:focus-visible {
    outline: 2px solid var(--ht-focus);
    outline-offset: 2px;
  }
  .grid-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .grid-cats button {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    min-height: 2rem;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--ht-border-strong);
    border-radius: var(--ht-radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ht-text);
  }
  .grid-cats button span {
    color: var(--ht-text-muted);
    font-family: var(--ht-font-mono);
    font-size: 0.75rem;
  }
  .grid-cats button[aria-pressed='true'] {
    background: var(--ht-text);
    border-color: var(--ht-text);
    color: var(--ht-bg);
  }
  .grid-cats button[aria-pressed='true'] span {
    color: inherit;
  }
  .grid-count {
    margin: 1rem 0;
    font-size: 0.875rem;
    color: var(--ht-text-muted);
  }
  .grid-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .grid-cards li[hidden] {
    display: none;
  }
  .grid-cards a {
    display: block;
    height: 100%;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ht-radius-lg);
    overflow: hidden;
    background: var(--ht-surface);
    color: var(--ht-text);
    text-decoration: none;
    transition: border-color var(--ht-duration) var(--ht-ease);
  }
  .grid-cards a:hover {
    border-color: var(--ht-border-strong);
  }
  /* The preview is a 1280x800 page scaled to fit the card. */
  .thumb {
    position: relative;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background: var(--ht-bg);
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .thumb iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1280px;
    height: 800px;
    border: 0;
    pointer-events: none;
    transform: scale(var(--thumb-scale, 0.25));
    transform-origin: top left;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem 1rem;
  }
  .eyebrow {
    font-family: var(--ht-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ht-text-muted);
  }
  .meta strong {
    font-family: var(--ht-font-display);
    font-size: 1rem;
  }
  .sum {
    font-size: 0.875rem;
    color: var(--ht-text-muted);
  }
  .meta code {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--ht-text-muted);
  }
  .grid-empty {
    padding: 2rem 0;
    color: var(--ht-text-muted);
  }
</style>

<style is:global>
  /* Room for three cards across. */
  :root {
    --sl-content-width: 64rem;
  }
</style>
