---
import EditLink from 'virtual:starlight/components/EditLink';
import Pagination from 'virtual:starlight/components/Pagination';
---

<div class="feedback">
  <div class="ask">
    <span class="q">Was this page helpful?</span>
    <span class="buttons">
      <ht-button variant="default" data-vote="yes">Yes</ht-button>
      <ht-button variant="default" data-vote="no">No</ht-button>
    </span>
  </div>
  <p class="thanks" role="status" hidden></p>
  <span class="edit"><EditLink /></span>
</div>
<Pagination />


<script>
  const box = document.querySelector<HTMLElement>('.feedback');
  box?.querySelectorAll<HTMLElement>('[data-vote]').forEach((b) =>
    b.addEventListener('click', () => {
      const thanks = box.querySelector<HTMLElement>('.thanks')!;
      thanks.textContent = b.dataset.vote === 'yes' ? 'Thanks. Glad it helped.' : 'Thanks. Tell us what to fix with Edit this page.';
      thanks.hidden = false;
      box.querySelector<HTMLElement>('.ask')!.hidden = true;
    }),
  );
</script>
